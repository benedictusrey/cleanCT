; cleanCT 1.0.0 - Inno Setup project
; Generated by installer/build_installer.py. Rebuild with:
;   ISCC.exe installer\cleanct.iss
#define MyAppName "cleanCT"
#define MyAppVersion "1.0.0"
#define MyAppExeName "cleanCT.exe"

[Setup]
AppName="cleanCT"
AppId=8E4F2C1A-77B3-4A62-9D5E-CLEANCT1000
AppVersion=1.0.0
DefaultDirName={autopf}\cleanCT
DefaultGroupName=cleanCT
UninstallDisplayIcon={app}\cleanCT.exe
OutputDir=out
OutputBaseFilename=cleanCT-1.0.0-setup
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
ArchitecturesInstallIn64BitMode=x64compatible
ArchitecturesAllowed=x64compatible
PrivilegesRequired=admin
MinVersion=10.0
; payload is ~703 MB uncompressed; lzma2/max compresses for distribution

[Tasks]
Name: "desktopicon"; Description: "Create a &desktop shortcut";     GroupDescription: "Additional icons:"

[Files]
Source: "_pkg\*"; DestDir: "{app}"; Flags: recursesubdirs ignoreversion

[Icons]
Name: "{group}\cleanCT"; Filename: "{app}\cleanCT.exe"
Name: "{autodesktop}\cleanCT"; Filename: "{app}\cleanCT.exe";     Tasks: desktopicon

; start as the original user: an elevated cleanCT cannot traverse its junctions (WinError 448)
[Run]
Filename: "{app}\cleanCT.exe"; Description: "Launch cleanCT"; Flags: nowait postinstall skipifsilent runasoriginaluser

[UninstallDelete]
; runtime logs/state live in %LOCALAPPDATA%\cleanCT (left on purpose)
Type: filesandordirs; Name: "{app}\logs"
